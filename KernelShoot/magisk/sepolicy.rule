# KernelShoot - sepolicy.rule
# 为 u:r:magisk:s0 上下文补充设备访问与 socket 权限
# (Magisk 给 service.sh 子进程的默认上下文为 magisk)
#
# 格式: allow source target:class { perms }

# 1. framebuffer /dev/graphics/fb0
allow magisk graphics_device:chr_file { read write open map getattr ioctl };

# 2. DRM /dev/dri/card0
allow magisk gpu_device:chr_file { read write open map getattr ioctl };
allow magisk drm_device:chr_file { read write open map getattr ioctl };

# 3. 抽象命名空间 LocalSocket (守护进程 server / app client)
allow magisk self:unix_stream_socket { create bind listen accept read write setopt };
allow magisk self:tcp_socket { create bind listen accept read write };

# 4. 写入 /sdcard/DCIM (sdcardfs / 媒体存储)
allow magisk media_rw_data_file:dir { search write add_name remove_name };
allow magisk media_rw_data_file:file { create write open read getattr unlink setattr };

# 5. 读取 /proc/[pid] (前台包名检测, 通常默认允许, 补充保险)
allow magisk proc:dir { search read open };
allow magisk proc:file { read open getattr };

# 6. 允许 app (untrusted_app 域) 连接 magisk 域的抽象 socket
allow untrusted_app magisk:unix_stream_socket connectto;
allow untrusted_app_25 magisk:unix_stream_socket connectto;
allow untrusted_app_27 magisk:unix_stream_socket connectto;
allow untrusted_app_29 magisk:unix_stream_socket connectto;
allow untrusted_app_30 magisk:unix_stream_socket connectto;
