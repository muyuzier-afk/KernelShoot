# KernelShoot - sepolicy.rule
# 仅 KernelSU: service.sh 跑在 u:r:su:s0 域
#
# KSU 启动时 apply_kernelsu_rules() 把 su 域设为 permissive 并注入
# ksu_allow(su, ALL, ALL, ALL), 因此守护进程访问 fb0/dri/sdcard 理论上
# 不会被拒; 但显式 allow 仍是推荐做法:
#   a) 避免 dmesg 刷 avc: denied 噪音
#   b) 兼容 KernelSU-Next / sus_su 等不默认 permissive 的分支
#
# 关键不可省略: App (untrusted_app, enforcing) 连接守护进程 (su 域) 的
# 抽象命名空间 socket 必须显式放行 connectto, 否则 Java 端 connect() 返回 EACCES.
# 这条规则与守护进程所在域是否 permissive 无关 (被拦的是 App 一侧).

# ---------- 1. 守护进程访问 framebuffer /dev/graphics/fb0 ----------
allow su graphics_device:chr_file { read write open map getattr ioctl };

# ---------- 2. DRM /dev/dri/card0 ----------
allow su gpu_device:chr_file { read write open map getattr ioctl };
allow su drm_device:chr_file { read write open map getattr ioctl };

# ---------- 3. 守护进程自身的 abstract socket (server 端) ----------
allow su self:unix_stream_socket { create bind listen accept read write setopt };

# ---------- 4. 写入 /sdcard/DCIM ----------
allow su media_rw_data_file:dir  { search write add_name remove_name };
allow su media_rw_data_file:file { create write open read getattr unlink setattr };
# 兼容部分设备 DCIM 走 storage_file 上下文
allow su storage_file:dir  { search write add_name remove_name };
allow su storage_file:file { create write open read getattr unlink setattr };

# ---------- 5. 读取 /proc/[pid] (前台包名检测) ----------
allow su proc:dir  { search read open };
allow su proc:file { read open getattr };

# ---------- 6. ★ App 连守护进程 socket (跨域, 必需) ----------
# App 在 untrusted_app 域 (enforcing), 必须显式允许 connectto
# 覆盖各 Android 版本变体
allow untrusted_app    su unix_stream_socket connectto;
allow untrusted_app_25 su unix_stream_socket connectto;
allow untrusted_app_27 su unix_stream_socket connectto;
allow untrusted_app_29 su unix_stream_socket connectto;
allow untrusted_app_30 su unix_stream_socket connectto;
allow untrusted_app_32 su unix_stream_socket connectto;

# ---------- 7. (可选) 调试用: 把跨域连接也记入 audit 方便排查 ----------
# auditallow untrusted_app su unix_stream_socket connectto;
